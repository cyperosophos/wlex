include "category.wlex";

type NullParam;
type NullSpan := (
    obj: Obj, par: NullParam,
);

fn terminal: NullParam -> NullSpan;
type TerminalMor := (
    mor: Mor, par: NullParam,
    target @ $mor == terminal @ $par,
);

fn NullSpan == (
    obj = source @ $mor,
    par = $par,
) @ TerminalMor;

type Param;
fn param_x: Param -> Obj;
fn param_y: Param -> Obj;
type Span := (
    p, q: Mor, par: Param,
    source @ ($p == $q),
    param_x == target @ $p,
    param_y == target @ $q,
);

fn product: Param @ ($ -> Span);
type Pairing := (
    mor: Mor, par: Param,
    target @ $mor == source @ $p @ product @ $par,
);

fn Span == (
    p = compose @ ($p @ product @ $par, $mor),
    q = compose @ ($q @ product @ $par, $mor),
    par = $par,
) @ Pairing;
