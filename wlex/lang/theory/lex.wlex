from cart import Cart;

spec Lex;
type C <- Cart;
type Obj := C.Obj;
type Mor := C.Mor
type Eq := C.Eq;
fn eq := C.eq;
fn source := C.source;
fn target := C.target;
fn compose := C.compose;

type Parallel = (
    i, j: Mor,
    (source, target) @ ($i == $j),
);
type Fork = (
    Mor, Parallel, Eq,
    source @ Parallel == target @ Mor,
    compose @ (Parallel, Mor) == eq,
);

fn equalizer: Parallel @ ($ -> Fork);

fn meqp := Mor @ equalizer @ Parallel;
type EqualizerMor := (
    Mor, Fork, Eq,
    source @ Mor @ ($ == Fork),
    target @ Mor == source @ meqp,
    (compose @ (meqp, Mor), Mor @ Fork) == eq,
);

# It's true that all morphisms to an equalizer object are equalizer pairings,
# but a morphism can be an equalizer pairing in more than one way (by following the poset of requirement sets).
fn equalizer_pairing: Fork @ ($ -> EqualizerMor);
fn equalizer_pairing_unique: Mor @ (equalizer_pairing, $) @ EqualizerMor -> eq;

# equalizer_pairing_eq: An equality of morphisms within forks
# must give an equality of their lifts. Cf. cart/pairing_eq
# For simplicity there is only one parallel pair, since if there
# were two equal parallel pairs one could just convert one fork into the
# other.
type ForkEq := (
    (x, p, c): Fork, (y, p, d): Fork, e: Eq,
    source @ ($x == $y), # TODO: One can currently skip requirements if they are implied by other requirements.
    target @ ($x == $y),
    ($x, $y) == eq,
)
fn equalizer_pairing_eq: Mor @ equalizer_pairing @ ForkEq -> eq; # pseucodish!
fn equalizer_pairing_eq = C.S.S.sym @ equalizer_pariring_unique @ (
    Mor, ($y, $p, $d),
    C.S.S.P.trans @ ($e, Eq @ EqualizerMor),
) @ equalizer_pairing @ ($x, $p, $c);

# Proof that f |-> compose @ ($mor @ equalizer, $f)
# has equalizer_pairing as retraction.
fn incl_compose: (
    Parallel, mor: Mor,
    target @ $mor == source @ $mor @ equalizer,
) -> equalizer_pairing; # TODO: This requires trim_join!! Keep it manual?
fn incl_compose = compose @ ($mor @ equalizer, $mor);
# TODO: In fact the source of incl_compose is isomorphic to EqualizerMor.
# What should be done is that a simpler version of EqualizerMor is needed
# since some of its components are redundant. Perhaps do the same with ProductMor?
# The result is then subproduct with one morphism and the limit diagram.

fn incl_mono: ($f, $g) @ (
    Parallel, f: Mor, g: Mor, e: Eq,
    compose @ ($mor @ equalizer, ($f, $g)) == eq @ $e,
) -> eq;
fn incl_mono = equalizer_pairing_unique @ ...