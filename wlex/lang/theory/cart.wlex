from category import Category;

spec CartLimit;
type Mor;
type Obj;
fn source: ;
fn target := C.target;
fn compose := C.compose;

type Span := (
    p, q: Mor,
    source @ ($p == $q),
);

type Pairing := (
    mor: Mor, x, y: Obj,
    target == product,
);

fn Span == (
    p = compose @ ($p @ product, $mor),
    q = compose @ ($q @ product, $mor),
) @ Pairing;

spec Cart;
type C <- Category;
type Obj := C.Obj;
type Mor := C.Mor;
type Eq := C.Eq;
fn eq := C.eq;
fn source := C.source;
fn target := C.target;
fn compose := C.compose;
fn terminal: Obj;
type TerminalMor := (
    Mor,
    target == terminal,
);
fn Obj == source @ TerminalMor;
#fn terminal_mor: Obj -> source @ TerminalMor;
#fn terminal_mor_unique: Mor @ (TerminalMor @ source, $) @ TerminalMor -> eq;
#terminal_mor_unique = ref;
# One uses $ == Terminal @ source when proving the hat.

type Span := (
    p, q: Mor,
    source @ ($p == $q),
);

fn product: (x, y: Obj) -> target @ Span;
#fn pt := product @ target @ Span;
type Pairing := (
    mor: Mor, x, y: Obj,
    target == product,
);
#type ProductMor := (
#    Mor, Span,
#    p_eq, q_eq: Eq,
#    source @ (Mor == Span),
#    target @ Mor == source @ pt,
#    # TODO: This needs some special notation like @>.
#    (compose @ (($p, $q) @ pt, Mor), Span) == eq @ ($p_eq, $q_eq),
#);
# TODO: Notice that it is possible to take Span out of ProductMor
# and just leave p_eq and q_eq, since these alread contain Span.
# The same may apply to SpanEq, etc. However one would then need
# to include the Span condition source @ target (p_eq == q_eq).
# fn pairing: Span -> target @ (p_eq, q_eq) @ ProductMor
# NOTE: When transpiling theories one makes sure no equalities are left unproven
# solely by the calls to eq, so one must make sure that the _hat functions are called
# even if their argument is None (which makes it look for a proof itself), but in this
# case one places the call at the end of the theory function (this is in fact what should always happen).
# No need for ~ inverse syntax. Name is optional in the case of isos.
# The fn ... == ... iso may or may not have a name.
# The distinguishing == syntax justifies using `iso` instead of `mor`.
# Tie iso to target type so it does not need to be named.
# A retraction must always be provided.

fn Span == (
    p = compose @ ($p @ product, $mor), # No Eq!
    q = compose @ ($q @ product, $mor),
) @ Pairing;
# =~ ...; # Use this to define inverse.
#fn pairing := ~span;
# span is the retraction of pairing. Unique existence is attained by
# having span be the inverse of pairing. span is ~pairing.
# Since pairing is an isomorphism it can be used as a tacit conversion?
# Is it canonical? Allow named isos, their inverse is ~<name>.

