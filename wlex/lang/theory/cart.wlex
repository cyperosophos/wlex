# Theorem: pairing preserves equality.
# TODO: Try making this a direct consequence of the iso.
# The idea is that an eq of Span elements translates to an eq of Pairing elements
# due to the existence of a retraction.
type SpanEq := (
    x: Span, y: Span, p_eq: Eq, q_eq: Eq,
    source @ ($x == $y), # TODO: these may be superfluous
    target @ ($x == $y),
    ($p, $q) @ ($x, $y) == eq @ ($p_eq, $q_eq),
);
fn pairing_eq: (
    $mor @ pairing @ $x,
    $mor @ pairing @ $y,
) @ SpanEq -> eq;
# TODO: Notice that this seems to requires preserving oroduct components as if they were variables.
fn pairing_eq = C.S.S.sym @ pairing_unique @ (
    Mor, $y,
    *C.S.S.P.trans @ (
        ($p_eq, $q_eq) @ SpanEq,
        ($p_eq, $q_eq) @ ProductMor,
    ),
) @ pairing @ $x;
# TODO: The more general result is that any function from Span
# preserves equality. How does one prove ps = pt & qs = qt => s = t?
# p, q are jointly mono, and in fact jointly iso. (p, q) is just span.
# Eq is just an equivalence relation, which need not be preserved by a function.
# compose_eq ensures that it is preserved.
# SpanEq is the equivalence relation on Span that gets preserved by pairing,
# as gets proven.

# That two Span elements are equal when their components are equal comes
# from pairing_eq.
type SpanEq := (
    x: Span, y: Span, p_eq: Eq, q_eq: Eq,
    ($p @ $x, $p @ $y) == eq @ $p_eq,
    ($q @ $x, $q @ $y) == eq @ $q_eq,
);
pairing_eq = ref @ (
) @ pairing @ $x;
# `pairing @ $x` is `pairing @ $y` in the sense that
# `span @ pairing @ $x` is equal to `$x` which is 'equal' to `$y`.
# `pairing` has to preserve Eq. This seems to be axiomatic.
# f, g are inverses. Assume a R b <=> fa S fb.
# x S y => fgx S fgy => gx R gy => fgx S fgy => x S y.
# Assume instead a R b => fa S fb and x S y => gx R gy.
# fa S fb => gfa R gfb => a R b.
# This is more fundamental, Span == Pairing is derived using ref.
# TODO: For simplicity (and consistency with Terminal) we keep axiomatic Span == Pairing. One derives the
# ref definition from the retractions and the uniqueness of inverses.
type SpanEq := (
    p, q: Eq,
    source @ ssource @ ($p == $q),
);
type PairingEq := (
    mor: Eq, x, y: Obj,
    target @ ssource == product,
);
fn SpanEq == (
    p = compose_eq @ (ref @ $p @ product, $mor),
    q = compose_eq @ (ref @ $q @ product, $mor),
) @ PairingEq;
pairing_eq := $mor @ PairingEq;

# TODO: Should one proof the naturality of the diagonal (for pullbacks)?
fn diag_natural: (
    compose @ ($mor @ pairing @ ($f, $g), $h),
    $mor @ pairing @ (compose @ ($f, $h), compose @ ($g, $h)),
) @ (
    (f, g): Span, h: Mor,
    target @ h == source @ $f,
) -> eq;
# Use the Span == Pairing hat to prove the diag_natural hat, especially
# the first component.
diag_natural = {
    k = $mor @ Pairing @ ($f, $g);
    $mor @ PairingEq @ (
        p = associativity @ ($p, $k, $h),
        q = associativity @ ($q, $k, $h),
    );
};
fn diag_natural = pairing_unique @ (
    compose @ ($mor, $h), compose @ ($f, $h), compose @ ($g, $h),
    C.S.S.P.trans @ (
        C.compose_eq @ ($p_eq, $h),
        associativity @ ($p @ pt, $mor, $h), # needs relabeling!
    )
    # ...
) @ pairing @ ($f, $g);

type RetSec := (
    r: Mor, s: Mor, e: Eq,
    (compose @ ($r, $s), identity @ source @ $s) == eq,
)

# f, g are parallel
# Just like lifting along inclusion, extending along projection preserves equality.
# The idea is that "for all f, f @ e can always be extended along e *in a unique way*" is equivalent to
# e is epi. (Dually for mono) (f |-> ) f @ e and m @ f are "meta split mono".
fn proj_section: (
    el: Mor, x, y: Obj,
    source @ el == terminal,
    target @ el == $y,
) -> RetSec;
fn pid := pairing @ (identity @ $x, compose @ ($el, terminal_mor @ $x));
fn proj_section = RetSec @ (
    $p @ product,
    $mor @ pid,
    C.S.S.transivity @ ($p_eq @ pid, ),
    # target @ Span @ $pid has to be ($x, $y)
    # identity @ $x has to be identity @ source @ $s
    # $p_eq @ $pid
    # ssource is compose @ ($p @ pt, $mor) @ pid. This seems to require naturality of diagonal!
    # starget is $p @ pid
    # target @ ($p, $q) @ pid == target @ (identity @ $x, compose @ ($el, terminal_mor @ $x)) by ^pairing
    # target @ identity @ $x == $x by ^identity
    # target @ compose @ ($el, terminal_mor @ $x) == $target @ $el by ^compose
    # target @ $el == $y by the requirement in the source
    # $p @ $pid == $p @ (identity @ $x, compose @ ($el, terminal_mor @ $x)) by ^pairing
    # ... == identity @ $x by $p_eq
    # $x == source @ $mor @ pid by requirement of ProductMor and by ^identity.
)

